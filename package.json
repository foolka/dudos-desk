{
  "name": "dudos-desk",
  "productName": "Dudos Desk",
  "version": "0.3.3",
  "private": true,
  "description": "Local playful desktop effects and OBS mirror for streamers",
  "author": "FermionaPlay",
  "license": "GPL-2.0-or-later",
  "main": "main.cjs",
  "engines": { "node": ">=24.14.0 <25" },
  "scripts": {
    "start": "electron .",
    "prestart": "npm run native",
    "native": "node tools/build-native.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tools/test-ui.cjs",
    "test:overlay": "node tools/test-overlay.cjs",
    "assets": "node tools/create-assets.cjs",
    "styles": "sass ui/styles/main.scss ui/style.css --no-source-map",
    "build": "node tools/build.cjs",
    "installer": "node tools/build-installer.cjs",
    "portable": "node tools/package-portable.cjs"
  },
  "dependencies": { "lucide": "0.468.0", "@twurple/api": "8.2.0", "@twurple/auth": "8.2.0", "@twurple/eventsub-ws": "8.2.0" },
  "devDependencies": {
    "electron": "42.11.18",
    "@electron/packager": "20.3.0",
    "playwright": "1.58.2",
    "sass": "1.106.1"
  }
}
